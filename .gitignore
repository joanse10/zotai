# ==========================================
build/
dist/
dist_installer/
*.manifest
*.spec.bak

# ==========================================
# Baze de date & Jurnale de execuție
# ==========================================
*.db
*.db-journal
*.sqlite
*.sqlite3
logs/
*.log

